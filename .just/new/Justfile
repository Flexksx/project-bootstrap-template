set working-directory := "../.."

[private]
default:
    just --list --justfile {{source_file()}}

# Scaffold a Python unit with `uv init`
python:
    .just/new/python.sh

# Scaffold a SvelteKit app with the `sv` wizard
sveltekit:
    .just/new/frontend.sh 'pnpm dlx sv create --no-dir-check "$TARGET"'

# Scaffold a Nuxt app with the `create-nuxt` wizard
nuxt:
    .just/new/frontend.sh 'pnpm create nuxt --force "$TARGET"'
