    "vitest": "^4.1.0"
  }
{% else %}  "scripts": {
    "postinstall": "nuxt prepare"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "nuxt": "^4.5.0",
    "typescript": "^5.9.0",
